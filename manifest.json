{
  "manifest_version": 3,
  "name": "BGA Tile Assistant",
  "version": "0.4.0",
  "description": "Displays remaining tile counts and draw probabilities for board games on boardgamearena.com.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://boardgamearena.com/*",
    "*://*.boardgamearena.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://boardgamearena.com/*/carcassonne*",
        "*://*.boardgamearena.com/*/carcassonne*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "tiles/*.png"],
      "matches": [
        "*://boardgamearena.com/*",
        "*://*.boardgamearena.com/*"
      ]
    }
  ]
}
